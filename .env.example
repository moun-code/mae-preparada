# ==============================================================================
# SEGUNDOS QUE SALVAM — Variáveis de Ambiente (Seção 5)
# Copie este arquivo para .env.local e preencha com os dados reais
# ==============================================================================

# 1. Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# 2. Cakto Checkout & Webhook
NEXT_PUBLIC_CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/ID_DA_OFERTA
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/ID_DA_OFERTA
CAKTO_WEBHOOK_SECRET=
# Se true, /api/cakto-webhook envia Purchase via CAPI (desative se a Cakto já enviar direto)
CAKTO_WEBHOOK_SEND_CAPI_PURCHASE=false

# 3. Captura de Leads (CRM / Planilha / n8n / Make)
LEAD_WEBHOOK_URL=

# 4. Flags de Controle de Produção e Especialista
# IMPORTANTE: Em produção real, defina ALLOW_PLACEHOLDERS=false
ALLOW_PLACEHOLDERS=true
NEXT_PUBLIC_ALLOW_PLACEHOLDERS=true
NEXT_PUBLIC_SPECIALIST_ENABLED=false

